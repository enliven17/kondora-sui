# Use your own Convex project for local development.
NEXT_PUBLIC_CONVEX_URL=
# gRPC endpoint. The app is pinned to Sui testnet.
NEXT_PUBLIC_SUI_RPC=https://fullnode.testnet.sui.io:443
# Optional overrides; defaults come from deployments/testnet.json.
NEXT_PUBLIC_SUI_PACKAGE_ID=
NEXT_PUBLIC_SUI_REGISTRY_ID=
NEXT_PUBLIC_SUI_FAUCET_ID=
# Server-side CLI/agents only. Never prefix these with NEXT_PUBLIC_.
# SUI_PRIVATE_KEY=
# SUI_KEY_FILE=.keys/agent.key
# CONVEX_DEPLOYMENT=
